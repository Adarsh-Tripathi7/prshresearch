bool isDark = i_theme == "Dark"

color C_R95 = isDark ? color.new(#34d399, 15) : color.new(#059669, 15)
color C_R90 = isDark ? color.new(#34d399, 30) : color.new(#059669, 30)
color C_R75 = isDark ? color.new(#38bdf8, 20) : color.new(#0284c7, 20)
